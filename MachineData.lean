@[expose] def decodeTransition (code : Nat) : Nat × Bool × Dir :=
  (code / 4, code / 2 % 2 == 1, if code % 2 = 1 then .right else .left)
@[expose] def k230Machine : Machine := fun q a =>
  if q < 230 then some (decodeTransition k230Codes[2*q + (if a then 1 else 0)]!) else none

theorem k230_transition_count : k230Codes.size = 460 := by decide
theorem k230_start_transition : k230Machine 0 false = some (94,true,.right) := by decide
theorem k230_halt_transition : k230Machine 68 true = some (230,true,.right) := by decide
theorem k230_halt_state (a : Bool) : k230Machine 230 a = none := by simp [k230Machine]
